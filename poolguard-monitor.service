[Unit]
Description=PoolGuard Monitor - API web de monitoring (FastAPI)
After=network.target

[Service]
Type=simple
User=rudyh
WorkingDirectory=/ssd/poolguard
ExecStart=/usr/bin/python3 -m uvicorn monitor_api:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
